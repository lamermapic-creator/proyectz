static func sortear(canal: String, p: float) -> float:
	var a: Array = SORTEAR[canal]
	var x := clampf(p, 0.0, 1.0) * (NU - 1)
	var i := mini(int(x), NU - 2)
	return lerpf(a[i], a[i + 1], x - i)


static func tumbar(canal: String, pb: float) -> float:
	var a: Array = TUMBAR[canal]
	var x := clampf(pb, 0.0, 1.0) * (NU - 1)
	var i := mini(int(x), NU - 2)
	return lerpf(a[i], a[i + 1], x - i)


static func reptar(canal: String, phi: float) -> float:
	var a: Array = REPTAR[canal]
	var x := fposmod(phi, 1.0) * N
	var i := int(x) % N
	return lerpf(a[i], a[(i + 1) % N], x - floorf(x))


static func salto(tipo: String, canal: String, t: float) -> float:
