## valor de un canal del ciclo en la fase phi (0..1, periódica), interpolación lineal entre muestras
static func ciclo(nombre: String, canal: String, phi: float) -> float:
	var a: Array = CICLOS[nombre][canal]
	var x := fposmod(phi, 1.0) * N
	var i := int(x) % N
	return lerpf(a[i], a[(i + 1) % N], x - floorf(x))


## curva del pie (u de 0 a 1)
static func pie(nombre: String, canal: String, u: float) -> float:
	var a: Array = CICLOS[nombre][canal]
	var x := clampf(u, 0.0, 1.0) * (NU - 1)
	var i := mini(int(x), NU - 2)
	return lerpf(a[i], a[i + 1], x - i)
